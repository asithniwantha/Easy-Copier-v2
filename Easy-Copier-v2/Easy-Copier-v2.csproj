<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
		<RootNamespace>EasyCopier</RootNamespace>
		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
		<Platforms>x64</Platforms>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>

		<!-- Required for Velopack updates and Administrator elevation -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

		<!-- C# 15 & Modern Safety Settings -->
		<LangVersion>15</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Show all analyzer warnings -->
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>All</AnalysisMode>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	  <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.3.260402-preview2" />
	  <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.3.260402-preview2" />
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
	  <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
	  <PackageReference Include="NReco.VideoConverter" Version="1.2.1" />
	  <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
	  <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
	  <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />
	  <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
	  <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
	  <PackageReference Include="System.Management" Version="11.0.0" />
	  <PackageReference Include="System.Windows.Extensions" Version="11.0.0" />
	  <PackageReference Include="Velopack" Version="1.2.161" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="Assets\AppIcon.ico">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Assets\AppIcon.png">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Assets\Failed_operation.wav">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Assets\successful_task_completion.wav">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
</Project>