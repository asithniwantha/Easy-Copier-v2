<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
		<RootNamespace>EasyCopier</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x64</Platforms>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>

		<!-- Required for Velopack updates and Administrator elevation -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

		<!-- C# 15 & Modern Safety Settings -->
		<LangVersion>15</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
	  <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
	  <PackageReference Include="System.Management" Version="11.0.0" />
	  <PackageReference Include="Velopack" Version="1.2.161" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="**\.gitkeep" />
	  <Folder Include="Features\History\" />
	  <Folder Include="Features\Library\Converters\" />
	  <Folder Include="Features\Library\Details\" />
	  <Folder Include="Features\Library\Metadata\" />
	  <Folder Include="Features\Library\Models\" />
	  <Folder Include="Features\Library\Scanning\" />
	  <Folder Include="Features\Library\Tabs\" />
	  <Folder Include="Features\OsImageLauncher\" />
	  <Folder Include="Features\Settings\About\" />
	  <Folder Include="Features\Shell\Contracts\" />
	  <Folder Include="Features\SmartAdder\Behaviors\" />
	  <Folder Include="Features\SmartAdder\Converters\" />
	  <Folder Include="Features\SmartAdder\Models\" />
	  <Folder Include="Features\TransferQueue\Models\" />
	  <Folder Include="Shared\Configuration\" />
	  <Folder Include="Shared\Interop\" />
	  <Folder Include="Shared\Messages\" />
	  <Folder Include="Shared\Persistence\" />
	  <Folder Include="Shared\Platform\" />
	  <Folder Include="Shared\UI\Converters\" />
	  <Folder Include="Shared\UI\Helpers\" />
	</ItemGroup>
</Project>