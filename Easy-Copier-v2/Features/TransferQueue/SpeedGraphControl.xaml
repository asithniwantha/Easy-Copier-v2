<UserControl
    x:Class="EasyCopier.Features.TransferQueue.SpeedGraphControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4">
        <Grid x:Name="GraphHost" MinHeight="48" SizeChanged="GraphHost_SizeChanged">
            <Canvas x:Name="GraphCanvas" IsHitTestVisible="False">
                <Polygon x:Name="AreaShape" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.2" />
                <Polyline x:Name="LineShape" Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                          StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
            <TextBlock x:Name="ScaleLabel" FontSize="10" Opacity="0.6" Margin="6,2,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
