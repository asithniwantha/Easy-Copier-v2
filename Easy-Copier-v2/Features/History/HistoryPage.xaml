<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyCopier.Features.History.HistoryPage"
    x:Name="RootHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:EasyCopier.Features.History"
    xmlns:models="using:EasyCopier.Features.History.Models"
    xmlns:sharedConverters="using:EasyCopier.Shared.UI.Converters"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <sharedConverters:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
        <sharedConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <sharedConverters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <sharedConverters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Thickness x:Key="CompactRowPadding">12,6,12,6</Thickness>
        <Thickness x:Key="ComfortableRowPadding">16,12,16,12</Thickness>

        <local:DensityToPaddingConverter x:Key="DensityToPaddingConverter"
                                         CompactPadding="{StaticResource CompactRowPadding}"
                                         ComfortablePadding="{StaticResource ComfortableRowPadding}"/>

        <DataTemplate x:Key="StatusBadgeTemplate" x:DataType="models:CopyHistoryRecord">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        Visibility="{x:Bind IsCompletedStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <TextBlock Text="Completed" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    </StackPanel>
                </Border>
                <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        Visibility="{x:Bind IsFailedStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="Failed" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </StackPanel>
                </Border>
                <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{x:Bind IsSkippedStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE893;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock Text="Skipped" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Transfer History" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.ToggleDashboardCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D2;" FontSize="14"/>
                        <TextBlock Text="Dashboard"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ExportToCsvCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                        <TextBlock Text="Export CSV"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tier 1: Macro 4-Card KPI Summary Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,20" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Total Volume Copied" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalItems, Mode=OneWay}"/>
                        <Run Text=" items (" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalBytes, Converter={StaticResource BytesToSizeConverter}, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Run Text=")" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Total Revenue Generated" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Margin="0,4,0,0">
                        <Run Text="Rs "/>
                        <Run Text="{x:Bind ViewModel.SelectedFilterStats.TotalAmount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Transfer Success Rate" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SelectedFilterStats.SuccessRate, Mode=OneWay}"
                               Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Last Updated" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}"
                               Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dashboard Analytics Collapse Card -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{x:Bind ViewModel.IsDashboardVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Dashboard" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <ComboBox HorizontalAlignment="Right" Width="150" ToolTipService.ToolTip="Dashboard time range"
                              ItemsSource="{x:Bind ViewModel.DashboardRangeOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedDashboardRange, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Daily volume" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DailyTotals, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PeriodTotal">
                                        <Grid Width="42" Height="140" ToolTipService.ToolTip="{x:Bind Label}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Rectangle Grid.Row="0" Height="{x:Bind BarHeight}" RadiusX="3" RadiusY="3"
                                                       VerticalAlignment="Bottom" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <TextBlock Grid.Row="1" Text="{x:Bind Label}" FontSize="10"
                                                       Opacity="0.7" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Failure rate" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.FailureRateText, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="Weekly totals" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.WeeklyTotals, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PeriodTotal">
                                    <TextBlock FontSize="12" Typography.NumeralAlignment="Tabular">
                                        <Run Text="{x:Bind Label}"/>
                                        <Run Text=": "/>
                                        <Run Text="{x:Bind TotalItems}"/>
                                        <Run Text=" items, "/>
                                        <Run Text="{x:Bind FailedItems}"/>
                                        <Run Text=" failed"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Most copied" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TopCopiedItem">
                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular">
                                        <Run Text="{x:Bind CopyCount}" FontWeight="SemiBold"/>
                                        <Run Text="x "/>
                                        <Run Text="{x:Bind Name}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Filter & Row Density Controls -->
        <Grid Grid.Row="3" Margin="0,0,0,12" Padding="16,12" CornerRadius="8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox Grid.Column="0"
                            PlaceholderText="Search Game/Drive..."
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find"
                            Width="250" Margin="0,0,12,0"
                            VerticalAlignment="Bottom"/>

            <ComboBox Grid.Column="1"
                      Header="Date:"
                      ItemsSource="{x:Bind ViewModel.AvailableDateFilterStrings, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedDateFilterString, Mode=TwoWay}"
                      Width="150" Margin="0,0,12,0"
                      VerticalAlignment="Bottom"/>

            <ComboBox Grid.Column="2"
                      Header="Status:"
                      ItemsSource="{x:Bind ViewModel.AvailableStatusFilterStrings, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedStatusFilterString, Mode=TwoWay}"
                      Width="130" Margin="0,0,12,0"
                      VerticalAlignment="Bottom"/>

            <Button Grid.Column="3"
                    VerticalAlignment="Bottom"
                    Content="Clear"
                    ToolTipService.ToolTip="Reset search and filters"
                    Command="{x:Bind ViewModel.ClearFiltersCommand}"/>

            <Button Grid.Column="5"
                    VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Toggle row density (Compact / Comfortable)"
                    Command="{x:Bind ViewModel.ToggleDensityCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8FD;" FontSize="13"/>
                    <TextBlock Text="{x:Bind ViewModel.DensityLabel, Mode=OneWay}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Tier 2 Workspace Table & Tier 3 Contextual Details Drawer -->
        <SplitView Grid.Row="4"
                   IsPaneOpen="{x:Bind ViewModel.IsDrawerOpen, Mode=TwoWay}"
                   DisplayMode="Inline"
                   PanePlacement="Right"
                   OpenPaneLength="380">
            <SplitView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Uniform Column Header Row -->
                    <Grid Grid.Row="0" Padding="16,6" ColumnSpacing="16"
                          Visibility="{x:Bind ViewModel.HasNoRecords, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="76"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="STATUS" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="ITEM &amp; TARGET DRIVE" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="SIZE" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="PRICE" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="DURATION" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                    </Grid>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedRecord, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="MinHeight" Value="36"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CopyHistoryRecord">
                                <Grid Padding="{Binding ViewModel.IsCompactDensity, ElementName=RootHistoryPage, Converter={StaticResource DensityToPaddingConverter}}"
                                      ColumnSpacing="16"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="76"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Grid.Column="0" Content="{x:Bind}" ContentTemplate="{StaticResource StatusBadgeTemplate}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind GameName}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular">
                                            <Run Text="{x:Bind FormattedTimestamp}"/>
                                            <Run Text=" &#x2022; "/>
                                            <Run Text="{x:Bind TargetDriveLetter}"/>
                                            <Run Text="{x:Bind TargetDriveLabel}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Typography.NumeralAlignment="Tabular">
                                        <Run Text="Rs "/>
                                        <Run Text="{x:Bind Amount}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" Text="{x:Bind FormattedDuration}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                Visibility="{x:Bind ViewModel.HasNoRecords, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <FontIcon Glyph="&#xE81C;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="No transfers match your filters" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Content="Clear filters" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ClearFiltersCommand}"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="0,8,0,0" Padding="14,8" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Visibility="{x:Bind ViewModel.HasNoRecords, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.TotalRecordSummaryText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       FontSize="12" Typography.NumeralAlignment="Tabular"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <Button Command="{x:Bind ViewModel.FirstPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                        Padding="8,6" ToolTipService.ToolTip="First Page"
                                        Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon Glyph="&#xE892;" FontSize="12"/>
                                </Button>
                                <Button Command="{x:Bind ViewModel.PreviousPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                        Padding="8,6" ToolTipService.ToolTip="Previous Page"
                                        Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.PaginationSummaryText, Mode=OneWay}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                                           Typography.NumeralAlignment="Tabular" Margin="10,0"/>
                                <Button Command="{x:Bind ViewModel.NextPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                        Padding="8,6" ToolTipService.ToolTip="Next Page"
                                        Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon Glyph="&#xE72A;" FontSize="12"/>
                                </Button>
                                <Button Command="{x:Bind ViewModel.LastPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                        Padding="8,6" ToolTipService.ToolTip="Last Page"
                                        Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon Glyph="&#xE893;" FontSize="12"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Page size:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox SelectedItem="{x:Bind ViewModel.SelectedPageSize, Mode=TwoWay}"
                                          ItemsSource="{x:Bind ViewModel.AvailablePageSizes, Mode=OneWay}"
                                          Width="80" Padding="6,2" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </SplitView.Content>

            <!-- Tier 3: Contextual Inspection Side Drawer -->
            <SplitView.Pane>
                <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.CloseDrawerCommand}"
                                ToolTipService.ToolTip="Close details (Esc)"
                                Margin="0,0,12,0"/>
                        <TextBlock Text="Transfer Details" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Padding="16">
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SelectedRecord, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Item Name" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.GameName, Mode=OneWay}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Outcome" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedRecord.DisplayStatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Duration" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedRecord.FormattedDuration, Mode=OneWay}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Source Path" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.SourcePath, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas, Courier New, monospace" FontSize="12" IsTextSelectionEnabled="True"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Destination Path" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.DestinationPath, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas, Courier New, monospace" FontSize="12" IsTextSelectionEnabled="True"/>
                            </StackPanel>

                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.SelectedRecord.IsSuccess, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                <TextBlock Text="Error Log" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRecord.ErrorLog, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" IsTextSelectionEnabled="True"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Sub-Files" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ListView ItemsSource="{x:Bind ViewModel.SelectedRecordSubFiles, Mode=OneWay}"
                                          SelectionMode="None"
                                          MaxHeight="300"
                                          Background="{ThemeResource LayerFillColorAltBrush}"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" FontSize="12"/>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>
        </SplitView>
    </Grid>
