<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EasyCopier.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EasyCopier">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Shared/UI/Styles.xaml" />
                <ResourceDictionary Source="ms-appx:///Features/Shell/Contracts/LibraryStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4"/>
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#107C10"/>
                    <SolidColorBrush x:Key="AppWarningBrush" Color="#FCE100"/>
                    <SolidColorBrush x:Key="AppErrorBrush" Color="#E81123"/>
                    <SolidColorBrush x:Key="PriceTextBrush" Color="#FFA500"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4"/>
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#107C10"/>
                    <SolidColorBrush x:Key="AppWarningBrush" Color="#8F7A00"/>
                    <SolidColorBrush x:Key="AppErrorBrush" Color="#A80000"/>
                    <SolidColorBrush x:Key="PriceTextBrush" Color="#D97706"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
